38266>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38269>>>        Case Begin
38269>>>            Case (NavigateData.eNavigateType = nfFromMain)
38271>>>                // If from main, this is a propbably a main file Select to Zoom.
38271>>>                Case Break
38272>>>
38272>>>            Case (NavigateData.eNavigateType = nfFromParent)
38275>>>                // If from parent, this is a constrained drill down.
38275>>>                Case Break
38276>>>
38276>>>            Case (NavigateData.eNavigateType = nfFromChild)
38279>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38279>>>                Case Break
38280>>>
38280>>>            Case Else // must be nfUndefined
38280>>>
38280>>>        Case End
38280>>>
38280>>>        Send SetActionButtons
38281>>>
38281>>>    End_Procedure
38282>>>
38282>>>End_Object 
