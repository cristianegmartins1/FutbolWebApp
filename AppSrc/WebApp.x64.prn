38241>>>        tWebNavigateData NavigateData
38241>>>        tWebNavigateData NavigateData
38241>>>        Boolean bHasRecord
38241>>>        Handle hoDD
38241>>>
38241>>>        Get Server to hoDD
38242>>>        Get GetNavigateData to NavigateData
38243>>>        Get HasRecord of hoDD to bHasRecord
38244>>>
38244>>>        // let's hide all buttons and then Show the ones we want
38244>>>        WebSet pbRender of oEditBtn to False
38245>>>        WebSet pbRender of oSaveBtn to False
38246>>>        WebSet pbRender of oCancelChangesBtn to False
38247>>>        WebSet pbRender of oDeleteBtn to False
38248>>> 
38248>>>
38248>>>        If (NavigateData.bReadOnly) Begin
38250>>>            WebSet pbRender of oEditBtn to True
38251>>>        End
38251>>>>
38251>>>        Else Begin
38252>>>            WebSet pbRender of oSaveBtn to True
38253>>>            WebSet pbRender of oCancelChangesBtn to True
38254>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38255>>>        End
38255>>>>
38255>>>    End_Procedure
