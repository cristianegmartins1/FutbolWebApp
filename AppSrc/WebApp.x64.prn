38416>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38419>>>        WebSet pbRender of oNewButton to True
38420>>>        WebSet pbRender of oDetailButton to True
38421>>>
38421>>>        Case Begin
38421>>>            Case (NavigateData.eNavigateType = nfFromParent)
38423>>>                // If from parent, this is a constrained drill down
38423>>>                // If Row select does main-zoom we don't need this
38423>>>                WebSet pbRender of oDetailButton to False
38424>>>                Case Break
38425>>>
38425>>>            Case (NavigateData.eNavigateType = nfFromChild)
38428>>>                // If from child, this is a probably a parent lookup from a Zoom
38428>>>                Case Break
38429>>>
38429>>>            Case (NavigateData.eNavigateType = nfFromMain)
38432>>>                // If from main, this is a probably a main-file lookup from a Zoom
38432>>>                WebSet pbRender of oDetailButton to False
38433>>>                Case Break
38434>>>
38434>>>            Case Else // must be nfUndefined
38434>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
38434>>>                // If Row select does main-zoom we don't need this
38434>>>                WebSet pbRender of oDetailButton to False
38435>>>
38435>>>        Case End
38435>>>
38435>>>    End_Procedure
